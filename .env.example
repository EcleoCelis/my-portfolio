# ============================================================================
# PORTFOLIO SYSTEM & POSTGRESQL CMS CONFIGURATION (.env.example)
# Copy this file to `.env` for local development or configure these variables
# in your hosting platform's secret manager (e.g., Render, Railway, Vercel).
# NEVER commit `.env` or expose API keys / credentials in Git.
# ============================================================================

# Local HTTP server port (defaults to 3000)
PORT=3000

# Verified recipient email address where hiring inquiries are delivered
CONTACT_RECIPIENT_EMAIL=jomaricelis22@gmail.com

# ----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------------------------------------
# Connection string format:
# postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example for local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db
# Example for managed cloud database (Neon, Supabase, Render, Railway):
# DATABASE_URL=postgresql://user:secret@ep-cool-db.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# Set to true if your database requires SSL/TLS (default false for localhost)
DATABASE_SSL=false

# ----------------------------------------------------------------------------
# Admin CMS Authentication
# ----------------------------------------------------------------------------
# Password used to authenticate at /admin to manage projects, upload screenshots,
# and read / triage incoming contact inquiries. Choose a strong passphrase.
ADMIN_PASSWORD=change_this_to_a_strong_secret_password

# ----------------------------------------------------------------------------
# Email Delivery Provider (Choose Option 1 or Option 2)
# ----------------------------------------------------------------------------
# Option 1 (Recommended): Resend Email API (https://resend.com)
# Obtain a free API key and set your verified sender address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Inquiry <onboarding@resend.dev>

# Option 2: Web3Forms Access Key (https://web3forms.com)
# Obtain a free access key sent directly to your email.
WEB3FORMS_ACCESS_KEY=
